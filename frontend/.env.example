# Base URL for the MedSys AI FastAPI backend. Leave empty to run the frontend
# entirely on mock data (no backend required).
VITE_API_BASE_URL=

# Optional: enables the live TomTom map on Find Care. Without this the page
# falls back to a static placeholder map that still supports selection.
VITE_TOMTOM_API_KEY=

# Required. Clerk (https://clerk.com) publishable key — gates the whole app
# behind sign-in and is also used to derive the backend's JWT issuer, so this
# must match the backend's CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=
