# Local MongoDB Compass connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=medsys_ai

# Model routing: chat/report/classify/tips default to a local Ollama model.
# If OLLAMA_MODEL is empty, the backend falls back to gpt-oss-20b on Groq
# Cloud. Same idea for document OCR via OLLAMA_VISION_MODEL, falling back to
# GROQ_VISION_MODEL if empty.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hf.co/unsloth/medgemma-4b-it-GGUF:Q4_K_M
OLLAMA_VISION_MODEL=hf.co/Mungert/medgemma-4b-pt-GGUF:Q4_K_M
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Groq-hosted Whisper for the composer's speech-to-text button.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Firecrawl (https://firecrawl.dev) scrapes full page content for the "Deep
# Search" button and model-triggered web search. Without a key, deep search
# still runs (DuckDuckGo results) but falls back to search-result snippets
# instead of full page text.
FIRECRAWL_API_KEY=

# Environmental intelligence (weather/AQI). Without a key, /home/snapshot
# falls back to the static demo environment card.
OPENWEATHER_API_KEY=
LOCATION_NAME=Bengaluru, IN
LOCATION_LAT=12.9716
LOCATION_LNG=77.5946

# Supermemory (https://supermemory.ai) powers the symptom knowledge graph:
# each logged symptom becomes a memory, and pattern detection searches for
# known risk-rule co-occurrences (e.g. chest pain + night sweats). Without a
# key, /home/snapshot falls back to the static demo alert.
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=medsys-symptoms
# Every chat turn (user + assistant) is also written here, separate from the
# symptom container so it never affects pattern-detection queries.
SUPERMEMORY_CHAT_CONTAINER_TAG=medsys-chat

# Local embedding model for RAG chunk retrieval (sentence-transformers,
# runs in-process — no external server required).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Clerk (https://clerk.com) authenticates the frontend and every router below
# `health` requires a valid Clerk session JWT (Authorization: Bearer <token>).
# CLERK_SECRET_KEY is only used server-side. CLERK_PUBLISHABLE_KEY must match
# the frontend's VITE_CLERK_PUBLISHABLE_KEY — the JWT issuer/JWKS host is
# derived from it, not configured separately.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
